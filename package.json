{
  "name": "nodejs-2026q1-knowledge-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Nest.js Knowledge Hub API",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "build": "npm run prisma:generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,tests,prisma}/**/*.ts\"",
    "prisma:generate": "PRISMA_SCHEMA_ENGINE_BINARY=/bin/true prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "test": "node --require ts-node/register --test tests/**/*.spec.ts",
    "test:coverage": "c8 --include='src/**/*.ts' --exclude='src/main.ts' --exclude='src/**/*.module.ts' --exclude='src/common/models/*.ts' --exclude='src/common/dto/*.ts' --exclude='src/common/interfaces/*.ts' node --require ts-node/register --test tests/**/*.spec.ts",
    "test:coverage:html": "c8 --reporter=html --include='src/**/*.ts' --exclude='src/main.ts' --exclude='src/**/*.module.ts' --exclude='src/common/models/*.ts' --exclude='src/common/dto/*.ts' --exclude='src/common/interfaces/*.ts' node --require ts-node/register --test tests/**/*.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^7.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "c8": "^11.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.2",
    "prisma": "^7.7.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.0.0"
  }
}
